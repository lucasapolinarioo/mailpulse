# Port injected automatically by ShardCloud
PORT=3000

# Secret used to sign tracked redirect links (/c/:id).
# Set a strong random string in production.
SIGNING_SECRET=change-me-to-a-strong-secret

# Public base URL of your ShardCloud app (used to build pixel/link URLs).
# Example: https://mailpulse.shardcloud.app
PUBLIC_BASE_URL=

# Directory where tracking data (store.json) is persisted
DATA_DIR=./data

# Grace window (ms) after track creation to ignore immediate compose/proxy fetches (default: 15000)
OPEN_GRACE_MS=15000
